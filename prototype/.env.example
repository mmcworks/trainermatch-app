# Prisma Database URL (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Resend API Key (https://resend.com/api-keys)
# Obrigatório para envio real de e-mails de validação de conta (código OTP de 6 dígitos)
RESEND_API_KEY="re_xxxxxxxxxxxxxx"

# Opcional: Remetente do e-mail.
# No plano gratuito do Resend, usa o remetente de teste padrão: "TrainerMatch <onboarding@resend.dev>"
# Ao verificar seu próprio domínio no Resend, altere para algo como: "TrainerMatch <contato@seudominio.com.br>"
RESEND_FROM_EMAIL="TrainerMatch <onboarding@resend.dev>"
